# Nuvio - environment template
# Salin file ini menjadi .env lalu isi nilai asli. Jangan pernah commit .env*.
# Referensi: docs/14. DevOps.md (14.5) & docs/15. Security.md (15.6)

# --- Supabase (auth + PostgreSQL) ---
# Lokal (Supabase CLI): http://127.0.0.1:54321
# Staging/Production:   https://<project-ref>.supabase.co
SUPABASE_URL="http://127.0.0.1:54321"
# Public anon key - aman dibawa ke client HANYA karena RLS aktif di semua tabel
SUPABASE_ANON_KEY="<anon-key>"
# Service role key (bypass RLS) - server only, TIDAK PERNAH sampai ke browser
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- AI Copilot ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY="<gemini-api-key>"

# --- Background jobs (Vercel Cron) ---
# Token autentikasi request cron; generate kuat: openssl rand -base64 32
CRON_SECRET="<cron-secret>"
